; domfie HMI WinUSB device association for Windows on ARM64
; Hardware ID from original Kinseal/libusb-win32 package: USB\VID_7365&PID_616C
; This uses Microsoft's in-box WinUSB driver (winusb.sys). No third-party SYS file is included.

[Version]
Signature   = "$Windows NT$"
Class       = USBDevice
ClassGuid   = {88BAE032-5A81-49F0-BC3D-A4FF138216D6}
Provider    = %ProviderName%
DriverVer   = 11/21/2026,1.0.2.0

[Manufacturer]
%ManufacturerName% = Standard,NTarm64

[Standard.NTarm64]
%DeviceName% = WinUSB_Install, USB\VID_7365&PID_616C

[WinUSB_Install.NT]
Include = winusb.inf
Needs   = WINUSB.NT

[WinUSB_Install.NT.Services]
Include = winusb.inf
Needs   = WINUSB.NT.Services

[WinUSB_Install.NT.HW]
AddReg = DeviceInterfaceGUIDs_AddReg

[DeviceInterfaceGUIDs_AddReg]
; Original DeviceGUID from Kinseal libusb-win32 INF, kept to maximize compatibility with software that searches for this GUID.
HKR,,DeviceInterfaceGUIDs,0x10000,"{F5970E6C-EBEE-424F-9249-8FECBAAB028F}"

[Strings]
ProviderName     = "domfie"
ManufacturerName = "domfie"
DeviceName       = "Smart Control Device"
